<Page x:Class="BizRent.Views.Accountant.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Платежи">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Новый платёж" 
                        Style="{StaticResource PrimaryButton}"
                        Width="150" 
                        Height="38" 
                        Margin="0,0,12,0"
                        Click="BtnNew_Click"/>

                <Button x:Name="BtnMarkAsPaid" 
                        Content="✅ Отметить оплаченным" 
                        Style="{StaticResource SecondaryButton}"
                        Width="200" 
                        Height="38" 
                        Margin="0,0,12,0"
                        Click="BtnMarkAsPaid_Click"/>

                <Button Content="🔄 Обновить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="122" 
                        Height="38" 
                        Margin="0,0,12,0"
                        Click="BtnRefresh_Click"/>

                <Button Content="⬅ Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Width="110" 
                        Height="38" 
                        Margin="0,0,12,0"
                        Click="BtnBack_Click"/>

                <ComboBox x:Name="ComboFilter" 
                          Width="160" 
                          Height="38" 
                          Style="{StaticResource ComboBoxStyle}"
                          Margin="0,0,12,0"
                          SelectionChanged="ComboFilter_SelectionChanged"/>

                <TextBox x:Name="TextBoxSearch" 
                         Width="220" 
                         Height="38" 
                         Style="{StaticResource TextBoxStyle}"
                         Margin="0,0,0,0"
                         TextChanged="TextBoxSearch_TextChanged"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="DataGridPayments" 
                  Grid.Row="1" 
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                    Binding="{Binding Id}" 
                                    Width="60"/>

                <DataGridTextColumn Header="Договор" 
                                    Binding="{Binding Contracts.ContractNumber}" 
                                    Width="130"/>

                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding PaymentTypes.Name}" 
                                    Width="110"/>

                <DataGridTextColumn Header="Сумма" 
                                    Binding="{Binding Amount, StringFormat=N0}" 
                                    Width="110"/>

                <DataGridTextColumn Header="Период" 
                                    Binding="{Binding Period, StringFormat=MM.yyyy}" 
                                    Width="90"/>

                <DataGridTextColumn Header="Срок оплаты" 
                                    Binding="{Binding DueDate, StringFormat=dd.MM.yyyy}" 
                                    Width="110"/>

                <DataGridTextColumn Header="Дата оплаты" 
                                    Binding="{Binding PaidDate, StringFormat=dd.MM.yyyy}" 
                                    Width="110"/>

                <DataGridTextColumn Header="Статус" 
                                    Binding="{Binding PaymentStatuses.Name}" 
                                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusId}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="5">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>