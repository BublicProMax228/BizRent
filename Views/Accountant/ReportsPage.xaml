<Page x:Class="BizRent.Views.Accountant.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Финансовые отчёты">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                <DatePicker x:Name="DatePickerFrom" Width="135" Height="38" Margin="0,0,12,0"
                            SelectedDateChanged="DatePicker_Changed"/>

                <TextBlock Text="по" VerticalAlignment="Center" Margin="10,0,8,0" FontSize="13"/>
                <DatePicker x:Name="DatePickerTo" Width="135" Height="38"
                            SelectedDateChanged="DatePicker_Changed"/>

                <Button Content="Сформировать" 
                        Style="{StaticResource PrimaryButton}"
                        Width="130" Height="38" Margin="20,0,12,0"
                        Click="BtnGenerate_Click"/>

                <Button Content="Печать" 
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Height="38" Margin="0,0,12,0"
                        Click="BtnPrint_Click"/>

                <Button Content="⬅ Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Width="100" Height="38"
                        Click="BtnBack_Click"/>
            </StackPanel>
        </Border>

        <!-- Основное содержание -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Область с таблицей и диаграммой -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <!-- Таблица -->
                <DataGrid x:Name="DataGridReport" 
                          Style="{StaticResource DataGridStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Visibility="Visible">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="130"/>
                        <DataGridTextColumn Header="Договор" Binding="{Binding Contract}" Width="130"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="220"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N0}" Width="110"/>
                        <DataGridTextColumn Header="Статус" 
                    Binding="{Binding Status}" 
                    Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,3"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Style.Triggers>
                                        <!-- Оплачено -->
                                        <DataTrigger Binding="{Binding Status}" Value="Оплачен">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <!-- Ожидает оплаты -->
                                        <DataTrigger Binding="{Binding Status}" Value="Ожидает оплаты">
                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                        <!-- Просрочено -->
                                        <DataTrigger Binding="{Binding Status}" Value="Просрочено">
                                            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                        <!-- Отменено / Частично оплачено / другие -->
                                        <DataTrigger Binding="{Binding Status}" Value="Отменен">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Частично оплачен">
                                            <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Диаграмма -->
                <Border x:Name="DiagramArea" 
        Background="White"
        CornerRadius="8"
        BorderBrush="{StaticResource BorderBrush}" 
        BorderThickness="1"
        Visibility="Collapsed"
        Padding="30">
                    <StackPanel x:Name="ChartGrid" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"
                Height="320"/>
                </Border>
                
            </Grid>

            <!-- Правая колонка - сводная статистика -->
            <Border Grid.Column="1" 
                    Background="{StaticResource SecondaryBrush}" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Padding="16">

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Сводная статистика" 
                                   FontSize="15" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>

                        <Button x:Name="BtnToggleView" 
                                Content="Диаграмма" 
                                Style="{StaticResource SecondaryButton}"
                                Width="110" Height="32" 
                                HorizontalAlignment="Right"
                                Margin="15,0,0,0"
                                Click="BtnToggleView_Click"/>
                    </StackPanel>

                    <Border Background="White" CornerRadius="6" Padding="12" Margin="0,12,0,8">
                        <StackPanel>
                            <TextBlock x:Name="TextTotalIncome" Text="0 ₽" 
                                       FontSize="21" FontWeight="SemiBold" 
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Общий доход" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" CornerRadius="6" Padding="10" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="TextPaid" Text="0 ₽" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Оплачено" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="10" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="TextOverdue" Text="0 ₽" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Text="Просрочено" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>