<Page x:Class="BizRent.Views.Accountant.AccountantPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель бухгалтера">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20" 
                CornerRadius="0 0 8 8">
            <StackPanel>
                <TextBlock Text="Панель бухгалтера" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Управление платежами, финансами и отчётностью" 
                           Foreground="#E0E0E0" 
                           FontSize="14" 
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="1" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top"
                   Margin="20" 
                   Orientation="Horizontal">

            <Border Width="240" Height="170" 
                    Background="White" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Margin="12"
                    Cursor="Hand"
                    MouseLeftButtonDown="CardPayments_MouseDown">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="💰" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Платежи" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Управление поступлениями и выплатами" 
                               TextWrapping="Wrap" TextAlignment="Center" 
                               FontSize="12" Foreground="Gray" Margin="16,0"/>
                </StackPanel>
            </Border>

            <Border Width="240" Height="170" 
                    Background="White" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Margin="12"
                    Cursor="Hand"
                    MouseLeftButtonDown="CardReports_MouseDown">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Отчёты" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Финансовая аналитика и отчёты" 
                               TextWrapping="Wrap" TextAlignment="Center" 
                               FontSize="12" Foreground="Gray" Margin="16,0"/>
                </StackPanel>
            </Border>

            <Border Width="240" Height="170" 
                    Background="White" 
                    CornerRadius="8" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1"
                    Margin="12"
                    Cursor="Hand"
                    MouseLeftButtonDown="CardContracts_MouseDown">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📑" FontSize="48" HorizontalAlignment="Center"/>
                    <TextBlock Text="Договоры" FontSize="18" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Финансовые условия договоров" 
                               TextWrapping="Wrap" TextAlignment="Center" 
                               FontSize="12" Foreground="Gray" Margin="16,0"/>
                </StackPanel>
            </Border>
        </WrapPanel>

        <Border Grid.Row="1" 
                VerticalAlignment="Bottom" 
                HorizontalAlignment="Center"
                Background="{StaticResource BackgroundBrush}" 
                CornerRadius="8" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1"
                Padding="20"
                Margin="20"
                Width="920">

            <StackPanel>
                <TextBlock Text="Финансовая статистика" 
                           FontSize="16" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,12"/>

                <WrapPanel>
                    <Border Width="210" Height="88" Background="White" CornerRadius="6" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TextMonthlyIncome" Text="0 ₽" 
                                       FontSize="22" FontWeight="SemiBold" 
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Доход за месяц" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Width="210" Height="88" Background="White" CornerRadius="6" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TextExpectedPayments" Text="0 ₽" 
                                       FontSize="22" FontWeight="SemiBold" 
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Ожидаемые платежи" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Width="210" Height="88" Background="White" CornerRadius="6" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TextOverduePayments" Text="0 ₽" 
                                       FontSize="22" FontWeight="SemiBold" 
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="Просроченные платежи" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Width="210" Height="88" Background="White" CornerRadius="6" 
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="6">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="TextAveragePayment" Text="0 ₽" 
                                       FontSize="22" FontWeight="SemiBold" 
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Средний платёж" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Button Content="Обновить статистику" 
                        Style="{StaticResource SecondaryButton}"
                        Width="180" Height="36" 
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0"
                        Click="BtnRefreshStats_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>