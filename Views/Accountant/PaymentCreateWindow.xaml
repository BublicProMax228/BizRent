<Window x:Class="BizRent.Views.Accountant.PaymentCreateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый платёж" 
        Height="650" 
        Width="460"
        Icon="pack://application:,,,/Data/Resource/icon.png"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Новый платёж"
                   FontSize="18" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,25"/>

        <!-- Поля с подписями -->
        <StackPanel Grid.Row="1">

            <StackPanel>
                <TextBlock Text="Договор *" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboContract" 
                          Style="{StaticResource ComboBoxStyle}"
                          DisplayMemberPath="ContractNumber"
                          SelectedValuePath="Id"
                          Height="42"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Тип платежа *" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <ComboBox x:Name="ComboPaymentType" 
                          Style="{StaticResource ComboBoxStyle}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Height="42"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Сумма (₽) *" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBox x:Name="TextBoxAmount" 
                         Style="{StaticResource TextBoxStyle}"
                         Height="42"
                         PreviewTextInput="TextBoxAmount_PreviewTextInput"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Период *" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <DatePicker x:Name="DatePickerPeriod" Height="42"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Срок оплаты до *" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <DatePicker x:Name="DatePickerDueDate" Height="42"/>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="Комментарий" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"/>
                <TextBox x:Name="TextBoxComment" 
                         Style="{StaticResource TextBoxStyle}"
                         Height="85"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,30,0,0">

            <Button Content="Создать платёж" 
                    Style="{StaticResource PrimaryButton}"
                    Width="160" 
                    Height="42"
                    Click="BtnCreate_Click"/>

            <Button Content="Отмена" 
                    Style="{StaticResource SecondaryButton}"
                    Width="110" 
                    Height="42"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>