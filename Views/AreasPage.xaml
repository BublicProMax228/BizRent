<Page x:Class="BizRent.Views.AreasPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Помещения">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Добавить" 
                        Style="{StaticResource PrimaryButton}"
                        Width="130" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnAdd_Click"/>

                <Button x:Name="BtnEdit" 
                        Content="✏️ Редактировать" 
                        Style="{StaticResource SecondaryButton}"
                        Width="160" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnEdit_Click"/>

                <Button Content="🗑️ Удалить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnDelete_Click"/>

                <Button Content="🔄 Обновить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnRefresh_Click"/>

                <Button Content="⬅ Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Width="110" 
                        Height="38" 
                        Margin="20,0,0,0"
                        Click="BtnBack_Click"/>

                <!-- Фильтры -->
                <ComboBox x:Name="ComboFilterType" 
                          Width="180" 
                          Height="38" 
                          Margin="25,0,10,0"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="ComboFilter_Changed"/>

                <ComboBox x:Name="ComboFilterStatus" 
                          Width="160" 
                          Height="38" 
                          Margin="10,0,0,0"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="ComboFilter_Changed"/>

                <TextBox x:Name="TextBoxSearch" 
                         Width="250" 
                         Height="38" 
                         Margin="15,0,0,0"
                         Style="{StaticResource TextBoxStyle}"
                         TextChanged="TextBoxSearch_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid x:Name="DataGridAreas" 
                  Grid.Row="1"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10"
                  MouseDoubleClick="DataGridAreas_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="260"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding AreaTypes.Name}" Width="140"/>
                <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="80"/>
                <DataGridTextColumn Header="Площадь м²" Binding="{Binding AreaSqM}" Width="110"/>
                <DataGridTextColumn Header="Цена/мес" Binding="{Binding PricePerMonth, StringFormat=N0}" Width="130"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding AreaStatuses.Name}" Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusId}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>