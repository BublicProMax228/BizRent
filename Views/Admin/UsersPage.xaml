<Page x:Class="BizRent.Views.Admin.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Управление пользователями">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Добавить" 
                        Style="{StaticResource PrimaryButton}"
                        Width="130" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnAdd_Click"/>

                <Button Content="✏️ Редактировать" 
                        Style="{StaticResource SecondaryButton}"
                        Width="160" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnEdit_Click"/>

                <Button Content="🗑️ Удалить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnDelete_Click"/>

                <Button Content="🔄 Обновить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnRefresh_Click"/>

                <Button Content="⬅ Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Width="110" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnBack_Click"/>

                <!-- Поиск -->
                <TextBox x:Name="TextBoxSearch" 
                         Width="260" 
                         Height="38" 
                         Margin="30,0,0,0"
                         Style="{StaticResource TextBoxStyle}"
                         TextChanged="TextBoxSearch_TextChanged"
                         HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Таблица -->
        <DataGrid x:Name="DataGridUsers" 
                  Grid.Row="1"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10"
                  MouseDoubleClick="DataGridUsers_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Username}" Width="140"/>
                <DataGridTextColumn Header="Фамилия" Binding="{Binding LastName}" Width="160"/>
                <DataGridTextColumn Header="Имя" Binding="{Binding FirstName}" Width="140"/>
                <DataGridTextColumn Header="Отчество" Binding="{Binding MiddleName}" Width="140"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="210"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Roles.Name}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>