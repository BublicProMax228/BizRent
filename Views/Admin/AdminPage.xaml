<Page x:Class="BizRent.Views.Admin.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель администратора">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20" 
                CornerRadius="0 0 12 12">
            <StackPanel>
                <TextBlock Text="Панель администратора" 
                           Foreground="White" 
                           FontSize="26" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Управление системой BizRent" 
                           Foreground="#E0E0E0" 
                           FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="25">
            <StackPanel>

                <!-- Быстрые действия - крупные карточки -->
                <TextBlock Text="Быстрые действия" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <WrapPanel HorizontalAlignment="Center">
                    <!-- Управление пользователями -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Width="280" 
                            Height="170" 
                            Margin="12"
                            Cursor="Hand" 
                            MouseLeftButtonDown="CardUsers_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="👥" FontSize="52" HorizontalAlignment="Center"/>
                            <TextBlock Text="Пользователи" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Управление аккаунтами" 
                                       FontSize="13" 
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <!-- Добавить пользователя -->
                    <Border Background="White" 
                            CornerRadius="12" 
                            Width="280" 
                            Height="170" 
                            Margin="12"
                            Cursor="Hand" 
                            MouseLeftButtonDown="CardAddUser_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="➕" FontSize="52" HorizontalAlignment="Center"/>
                            <TextBlock Text="Добавить пользователя" 
                                       FontSize="18" 
                                       FontWeight="SemiBold" 
                                       Margin="0,12,0,4"/>
                            <TextBlock Text="Новый аккаунт" 
                                       FontSize="13" 
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Сводная статистика -->
                <TextBlock Text="Сводная статистика системы" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Margin="0,30,0,20"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="10" Padding="20" Width="220" Margin="8">
                        <StackPanel>
                            <TextBlock x:Name="TextTotalUsers" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Всего пользователей" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="220" Margin="8">
                        <StackPanel>
                            <TextBlock x:Name="TextTotalTenants" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Арендаторов" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="220" Margin="8">
                        <StackPanel>
                            <TextBlock x:Name="TextActiveContracts" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Активных договоров" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="220" Margin="8">
                        <StackPanel>
                            <TextBlock x:Name="TextNewApplications" Text="0" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Новых заявок" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>