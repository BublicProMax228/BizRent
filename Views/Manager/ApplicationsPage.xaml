<Page x:Class="BizRent.Views.Manager.ApplicationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Заявки">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Новая заявка" 
                        Style="{StaticResource PrimaryButton}"
                        Width="150" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnNew_Click"/>

                <Button x:Name="BtnProcess" 
                        Content="🔄 В обработку" 
                        Style="{StaticResource SecondaryButton}"
                        Width="150" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnProcess_Click"/>

                <Button x:Name="BtnView" 
                        Content="👁️ Просмотр" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnView_Click"/>

                <Button Content="🗑️ Удалить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnDelete_Click"/>

                <!-- Фильтр и поиск -->
                <ComboBox x:Name="ComboFilter" 
                          Width="180" 
                          Height="38" 
                          Margin="20,0,10,0"
                          Style="{StaticResource ComboBoxStyle}"
                          SelectionChanged="ComboFilter_SelectionChanged"/>

                <TextBox x:Name="TextBoxSearch" 
                         Width="260" 
                         Height="38" 
                         Margin="0,0,0,0"
                         Style="{StaticResource TextBoxStyle}"
                         TextChanged="TextBoxSearch_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Таблица заявок -->
        <DataGrid x:Name="DataGridApplications" 
                  Grid.Row="1"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10"
                  MouseDoubleClick="DataGridApplications_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="180"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Помещение" Binding="{Binding Areas.Name}" Width="160"/>
                <DataGridTextColumn Header="Статус" 
                    Binding="{Binding ApplicationStatuses.Name}" 
                    Width="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Style.Triggers>
                                <!-- Новые -->
                                <DataTrigger Binding="{Binding StatusId}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <!-- В обработке -->
                                <DataTrigger Binding="{Binding StatusId}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                                <!-- Просмотр объекта -->
                                <DataTrigger Binding="{Binding StatusId}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                </DataTrigger>
                                <!-- Ожидает договора -->
                                <DataTrigger Binding="{Binding StatusId}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                </DataTrigger>
                                <!-- Отклонена -->
                                <DataTrigger Binding="{Binding StatusId}" Value="5">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Users.LastName}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>