<Page x:Class="BizRent.Views.Manager.ContractsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Договоры">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" 
                Background="{StaticResource SecondaryBrush}" 
                Padding="12" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0 0 0 1">

            <StackPanel Orientation="Horizontal">

                <Button Content="➕ Новый договор" 
                        Style="{StaticResource PrimaryButton}"
                        Width="160" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnAdd_Click"/>

                <Button x:Name="BtnEdit" 
                        Content="✏️ Редактировать" 
                        Style="{StaticResource SecondaryButton}"
                        Width="160" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnEdit_Click"/>

                <Button Content="🗑️ Удалить" 
                        Style="{StaticResource SecondaryButton}"
                        Width="120" 
                        Height="38" 
                        Margin="0,0,10,0"
                        Click="BtnDelete_Click"/>

                <!-- Фильтры -->
                <ComboBox x:Name="ComboFilterStatus" 
                  Width="180" 
                  Height="38" 
                  Margin="25,0,10,0"
                  Style="{StaticResource ComboBoxStyle}"
                  SelectionChanged="ComboFilterStatus_SelectionChanged"/>

                <DatePicker x:Name="DatePickerFrom" 
                    Width="135" 
                    Height="38" 
                    Margin="10,0,5,0"
                    SelectedDateChanged="DatePickerFrom_SelectedDateChanged"/>

                <DatePicker x:Name="DatePickerTo" 
                    Width="135" 
                    Height="38" 
                    Margin="5,0,0,0"
                    SelectedDateChanged="DatePickerTo_SelectedDateChanged"/>

                <Button Content="⬅ Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Width="110" 
                        Height="38" 
                        Margin="20,0,0,0"
                        Click="BtnBack_Click"/>
            </StackPanel>
        </Border>

        <!-- Таблица договоров -->
        <DataGrid x:Name="DataGridContracts" 
                  Grid.Row="1"
                  Style="{StaticResource DataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10"
                  MouseDoubleClick="DataGridContracts_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Номер договора" Binding="{Binding ContractNumber}" Width="160"/>
                <DataGridTextColumn Header="Арендатор" Binding="{Binding Tenants.CompanyName}" Width="200"/>
                <DataGridTextColumn Header="Помещение" Binding="{Binding Areas.Name}" Width="160"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Плата/мес" Binding="{Binding MonthlyPayment, StringFormat=N0}" Width="120"/>
                <DataGridTextColumn Header="Статус" 
                    Binding="{Binding ContractStatuses.Name}" 
                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusId}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                    <!-- Черновик -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                                    <!-- Активен -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="3">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    <!-- Завершен -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="4">
                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                    <!-- Расторгнут -->
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusId}" Value="5">
                                    <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
                                    <!-- На согласовании -->
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>