<Page x:Class="BizRent.Views.Manager.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Панель менеджера">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="{StaticResource PrimaryBrush}" 
                Padding="20" 
                CornerRadius="0 0 12 12">
            <StackPanel>
                <TextBlock Text="Панель менеджера" 
                           Foreground="White" 
                           FontSize="26" 
                           FontWeight="SemiBold"/>
                <TextBlock Text="Управление заявками и договорами" 
                           Foreground="#E0E0E0" 
                           FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="25">
            <StackPanel>

                <!-- Быстрые переходы (крупные карточки) - сверху -->
                <TextBlock Text="Быстрые переходы" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                    <Border Background="White" CornerRadius="12" Width="280" Height="160" Margin="12"
                            Cursor="Hand" MouseLeftButtonDown="CardApplications_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📋" FontSize="46"/>
                            <TextBlock Text="Заявки" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="Обработка заявок" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Width="280" Height="160" Margin="12"
                            Cursor="Hand" MouseLeftButtonDown="CardContracts_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="46"/>
                            <TextBlock Text="Договоры" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="Арендные договоры" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Width="280" Height="160" Margin="12"
                            Cursor="Hand" MouseLeftButtonDown="CardAreas_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏢" FontSize="46"/>
                            <TextBlock Text="Помещения" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="Свободные площади" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="12" Width="280" Height="160" Margin="12"
                            Cursor="Hand" MouseLeftButtonDown="CardClients_MouseDown">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.1"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🤝" FontSize="46"/>
                            <TextBlock Text="Арендаторы" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBlock Text="База клиентов" FontSize="13" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Сводная статистика (внизу) -->
                <TextBlock Text="Ключевые показатели" 
                           FontSize="17" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,20"/>

                <WrapPanel HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="10" Padding="20" Width="230" Margin="10">
                        <StackPanel>
                            <TextBlock x:Name="TextNewApps" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text="Новых заявок" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="230" Margin="10">
                        <StackPanel>
                            <TextBlock x:Name="TextActiveContracts" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="Активных договоров" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="230" Margin="10">
                        <StackPanel>
                            <TextBlock x:Name="TextAvailableAreas" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Свободных помещений" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="20" Width="230" Margin="10">
                        <StackPanel>
                            <TextBlock x:Name="TextExpiringContracts" Text="0" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text="Заканчиваются скоро" FontSize="13" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>