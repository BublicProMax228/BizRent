<Window x:Class="BizRent.Views.Manager.ContractEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Договор" 
        Height="700" 
        Width="520"
        MinHeight="700" 
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="WindowTitle" 
                   Grid.Row="0"
                   Text="Новый договор" 
                   FontSize="20" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,20"/>

        <!-- Форма -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelColumn"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер договора*" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TextBoxNumber" Style="{StaticResource TextBoxStyle}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Арендатор*" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ComboTenant" 
                      Style="{StaticResource ComboBoxStyle}"
                      DisplayMemberPath="CompanyName"
                      SelectedValuePath="Id"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Тип договора*" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ComboType" 
          Style="{StaticResource ComboBoxStyle}"
          DisplayMemberPath="Name"
          SelectedValuePath="Id"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Помещение*" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ComboArea" 
                      Style="{StaticResource ComboBoxStyle}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата начала*" Style="{StaticResource LabelStyle}"/>
            <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DatePickerStart" Height="38"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Дата окончания*" Style="{StaticResource LabelStyle}"/>
            <DatePicker Grid.Row="5" Grid.Column="1" x:Name="DatePickerEnd" Height="38"/>

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Плата в месяц (₽)*" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="6" Grid.Column="1" x:Name="TextBoxMonthlyPayment" 
                     Style="{StaticResource TextBoxStyle}"
                     PreviewTextInput="TextBoxPrice_PreviewTextInput"/>

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Депозит (₽)" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="TextBoxDeposit" 
                     Style="{StaticResource TextBoxStyle}"
                     PreviewTextInput="TextBoxPrice_PreviewTextInput"/>

            <TextBlock Grid.Row="8" Grid.Column="0" Text="Статус*" Style="{StaticResource LabelStyle}"/>
            <ComboBox Grid.Row="8" Grid.Column="1" x:Name="ComboStatus" 
                      Style="{StaticResource ComboBoxStyle}"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <TextBlock Grid.Row="9" Grid.Column="0" Text="Заметки" Style="{StaticResource LabelStyle}"/>
            <TextBox Grid.Row="9" Grid.Column="1" x:Name="TextBoxNotes" 
                     Style="{StaticResource TextBoxStyle}"
                     Height="80"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,30,0,0">

            <Button x:Name="BtnSave" 
                    Content="Сохранить" 
                    Style="{StaticResource PrimaryButton}"
                    Width="130" 
                    Height="38" 
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>

            <Button Content="Отмена" 
                    Style="{StaticResource SecondaryButton}"
                    Width="110" 
                    Height="38"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>